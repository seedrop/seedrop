{
  "name": "@seedrop/protocol",
  "version": "0.1.0-alpha.1",
  "description": "Seedrop v2 protocol primitives: IDs, identity, health, commands, repair Receipts, explainable bounded observability, bytes, errors, versions, and migrations.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "generate:artifacts": "npm run build && node scripts/generate-protocol-artifacts.mjs --write",
    "check:artifacts": "node scripts/generate-protocol-artifacts.mjs --check",
    "generate:state-model": "npm run build && npm run check:artifacts && node scripts/generate-state-model-proof.mjs --write",
    "check:state-model": "node scripts/verify-state-model-proof.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:golden": "npm run build && node scripts/verify-golden.mjs",
    "verify:identity-corpus": "npm run build && node scripts/verify-identity-corpus.mjs",
    "verify:identity-corpus:live": "npm run build && node scripts/verify-identity-corpus.mjs --live",
    "verify:health-golden": "npm run build && node scripts/verify-health-golden.mjs",
    "verify:command-recovery-golden": "npm run build && node scripts/verify-command-recovery-golden.mjs",
    "generate:project-transaction": "npm run build && node scripts/generate-project-transaction-golden.mjs --write",
    "verify:project-transaction": "npm run build && node scripts/verify-project-transaction-golden.mjs",
    "verify:observability-golden": "npm run build && node scripts/verify-observability-golden.mjs",
    "verify:protocol-generation": "npm run build && node scripts/verify-protocol-generation.mjs",
    "verify:state-model": "npm run build && npm run check:artifacts && npm run check:state-model",
    "verify:runtime-goldens": "npm run build && node scripts/verify-runtime-goldens.mjs",
    "prepublishOnly": "npm run build && npm run check:artifacts && npm run check:state-model && npm test"
  },
  "files": [
    "src/",
    "dist/",
    "generated/",
    "fixtures/",
    "scripts/",
    "README.md"
  ],
  "keywords": [
    "seedrop",
    "protocol",
    "canonical-json",
    "uuidv7",
    "health-envelope",
    "command-audit",
    "repair-receipts",
    "bounded-observability",
    "telemetry-consent",
    "state-model",
    "property-testing",
    "migrations"
  ],
  "author": "Mariusz Czaykowski",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seedrop/seedrop.git",
    "directory": "protocol"
  }
}
