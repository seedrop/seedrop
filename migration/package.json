{
  "name": "@seedrop/migration",
  "version": "0.1.0-alpha.1",
  "description": "Seedrop v2 read-only corpus import and shadow reconciliation boundary.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:identity-import": "npm run build && node scripts/verify-identity-import.mjs",
    "verify:identity-import:live": "npm run build && node scripts/verify-identity-import.mjs --live",
    "verify:view-history-import:live": "npm run build && node scripts/verify-view-history-import.mjs",
    "verify:compatibility:live": "npm run build && node scripts/verify-view-history-import.mjs",
    "verify:coordination-import:live": "npm run build && node scripts/verify-coordination-import.mjs",
    "verify:machine-corpus:live": "npm run build && node scripts/verify-machine-corpus.mjs",
    "verify:clean-clone": "npm run build && npm run build -w @seedrop/project && node scripts/verify-clean-clone.mjs",
    "verify:executor": "vitest run tests/executor.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "src/",
    "dist/",
    "scripts/",
    "README.md"
  ],
  "author": "Mariusz Czaykowski",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@seedrop/id": "^0.2.0-alpha.5",
    "@seedrop/outcomes": "^0.1.0-alpha.1",
    "@seedrop/project": "^0.1.0-alpha.1",
    "@seedrop/protocol": "^0.1.0-alpha.1",
    "@seedrop/situation": "^0.1.0-alpha.1",
    "@seedrop/space": "^0.2.0-alpha.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seedrop/seedrop.git",
    "directory": "migration"
  }
}
