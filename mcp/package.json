{
  "name": "@seedrop/mcp",
  "version": "0.2.0-alpha.3",
  "description": "Model Context Protocol server for Seedrop — exposes seed continuity, bootstrap, view, and space as MCP tools.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "seed-mcp": "./bin/seed-mcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && node -e \"const fs=require('node:fs');const f='dist/cli.js';fs.chmodSync(f,fs.statSync(f).mode|0o755)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "bin/",
    "src/",
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "llm",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "seedrop"
  ],
  "author": "Mariusz Czaykowski",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@seedrop/cli": "^0.2.0-alpha.3",
    "@seedrop/id": "^0.2.0-alpha.3",
    "@seedrop/space": "^0.2.0-alpha.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "tsx": "^4.22.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seedrop/seedrop.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/seedrop/seedrop#readme",
  "bugs": "https://github.com/seedrop/seedrop/issues"
}
