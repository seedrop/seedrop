{
  "name": "@seedrop/situation",
  "version": "0.1.0-alpha.1",
  "description": "Seedrop v2 deterministic, provenance-aware orientation projection.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "generate": "node scripts/generate-adapter-contract.mjs",
    "check:generated": "node scripts/generate-adapter-contract.mjs --check",
    "test": "npm run check:generated && vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": ["src/", "dist/", "generated/", "README.md"],
  "author": "Mariusz Czaykowski",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "dependencies": {
    "@seedrop/outcomes": "^0.1.0-alpha.1",
    "@seedrop/project": "^0.1.0-alpha.1",
    "@seedrop/protocol": "^0.1.0-alpha.1"
  },
  "devDependencies": { "@types/node": "^20.0.0", "typescript": "^5.4.0", "vitest": "^4.1.6" },
  "repository": { "type": "git", "url": "git+https://github.com/seedrop/seedrop.git", "directory": "situation" }
}
