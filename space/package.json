{
  "name": "@seedrop/space",
  "version": "0.1.0-alpha.2",
  "description": "Coordination space for LLM agents — workspaces, presence, and pointer-based notifications over a file-backed durability substrate.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "seed-space": "./bin/seed-space.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && node -e \"const fs=require('node:fs');const f='dist/cli.js';fs.chmodSync(f,fs.statSync(f).mode|0o755)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:http": "tsx scripts/smoke-http.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "bin/",
    "src/",
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CHARTER.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "llm",
    "ai-agents",
    "coordination",
    "workspace",
    "multi-agent",
    "agent-coordination",
    "notifications"
  ],
  "author": "Mariusz Czaykowski",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "tsx": "^4.21.1",
    "zod": "^3.25.76"
  }
}
