{
  "name": "@seedrop/bench",
  "version": "0.2.0-alpha.5",
  "description": "Local workbench for Seedrop project, View, and agent state.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "seed-bench": "./bin/seed-bench.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && node -e \"const fs=require('node:fs');const f='dist/cli.js';fs.chmodSync(f,fs.statSync(f).mode|0o755)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "bin/",
    "src/",
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "llm",
    "ai-agents",
    "workbench",
    "agent-coordination",
    "seedrop"
  ],
  "author": "Mariusz Czaykowski",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@seedrop/id": "^0.2.0-alpha.5",
    "@seedrop/observer": "^0.2.0-alpha.5",
    "@seedrop/space": "^0.2.0-alpha.5",
    "tsx": "^4.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seedrop/seedrop.git",
    "directory": "bench"
  },
  "homepage": "https://github.com/seedrop/seedrop#readme",
  "bugs": "https://github.com/seedrop/seedrop/issues"
}
