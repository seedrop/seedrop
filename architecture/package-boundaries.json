{
  "schema_version": "1.0",
  "packages": {
    "@seedrop/protocol": {
      "workspace": "protocol",
      "role": "domain_contract",
      "owns": [
        "commands",
        "events",
        "identifiers",
        "schemas",
        "state_transitions",
        "versions"
      ],
      "allowed_internal_dependencies": []
    },
    "@seedrop/kernel": {
      "workspace": "kernel",
      "role": "command_kernel",
      "owns": [
        "state_changing_command_execution"
      ],
      "allowed_internal_dependencies": [
        "@seedrop/project",
        "@seedrop/protocol"
      ]
    },
    "@seedrop/project": {
      "workspace": "project",
      "role": "project_record",
      "owns": [
        "canonical_project_transactions",
        "project_receipts",
        "project_projections",
        "project_health_and_quarantine"
      ],
      "allowed_internal_dependencies": [
        "@seedrop/protocol"
      ]
    },
    "@seedrop/migration": {
      "workspace": "migration",
      "role": "shadow_migration",
      "owns": [
        "v1_read_only_source_admission",
        "source_snapshot_binding",
        "staged_shadow_import",
        "migration_reconciliation"
      ],
      "allowed_internal_dependencies": [
        "@seedrop/id",
        "@seedrop/outcomes",
        "@seedrop/project",
        "@seedrop/protocol",
        "@seedrop/situation",
        "@seedrop/space"
      ]
    },
    "@seedrop/outcomes": {
      "workspace": "outcomes",
      "role": "external_outcome_projection",
      "owns": [
        "validation_observation_projection",
        "delivery_observation_projection",
        "outcome_freshness_and_contradiction",
        "negative_continuity_grave_projection",
        "source_digest_claim_invalidation"
      ],
      "allowed_internal_dependencies": [
        "@seedrop/protocol"
      ]
    },
    "@seedrop/situation": {
      "workspace": "situation",
      "role": "deterministic_orientation_projection",
      "owns": [
        "situation_compilation",
        "field_provenance_freshness_completeness",
        "justified_next_action_or_refusal",
        "bounded_orientation_encoding",
        "adapter_semantic_projection_and_fallback"
      ],
      "allowed_internal_dependencies": [
        "@seedrop/outcomes",
        "@seedrop/project",
        "@seedrop/protocol"
      ]
    }
  },
  "adapters": {
    "@seedrop/cli": ["transport", "presentation"],
    "@seedrop/mcp": ["transport", "presentation"],
    "@seedrop/observer": ["observation_adapter"],
    "@seedrop/bench": ["evaluation_adapter", "presentation"],
    "@seedrop/desktop": ["transport", "presentation"]
  },
  "shadow_only_packages": [
    "@seedrop/kernel",
    "@seedrop/project",
    "@seedrop/migration",
    "@seedrop/outcomes",
    "@seedrop/situation"
  ],
  "shadow_projection_consumers": {
    "@seedrop/situation": [
      "@seedrop/cli",
      "@seedrop/id",
      "@seedrop/mcp",
      "@seedrop/observer"
    ],
    "@seedrop/migration": [
      "@seedrop/cli"
    ]
  },
  "rules": {
    "adapters_own_domain_semantics": false,
    "v1_writers_remain_authoritative": true,
    "custom_database_is_main_path": false,
    "wave_4_cutover_authorized": false,
    "migration_v1_source_access": "read_only",
    "wave_5_shadow_mismatch_behavior": "serve_v1"
  }
}
